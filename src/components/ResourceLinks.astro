---
/** Shared resource-link presentation; callers decide whether empty lists render. */
interface Props {
  links: readonly { label: string; href?: string }[];
  label?: string;
}

const { links, label } = Astro.props;
---

<p class="resource-links" aria-label={label}>
  {links.map((link) => (
    <>
      {link.href ? (
        <a href={link.href}>{link.label}</a>
      ) : (
        <span>{link.label}</span>
      )}
    </>
  ))}
</p>
