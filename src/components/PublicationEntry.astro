---
import ResourceLinks from './ResourceLinks.astro';
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
  annotated?: boolean;
}

const { publication, annotated = false } = Astro.props;
---

<article
  class:list={[
    'publication',
    {
      'publication--representative': publication.selected,
      'publication--compact': !publication.selected,
    },
  ]}
>
  <h3>{publication.title}</h3>
  <p class="publication__authors">
    {publication.authors.map((author, index) => (
      <>
        {index > 0 && ', '}
        {author === 'Ye Shu' ? <strong>{author}</strong> : author}
      </>
    ))}
  </p>
  <p class="publication__venue">
    {publication.venue}, {publication.year}.
    {publication.award && (
      <span class="publication__award"> {publication.award}</span>
    )}
  </p>
  {publication.links.length > 0 && (
    <ResourceLinks
      links={publication.links}
      label={`Resources for ${publication.title}`}
    />
  )}
  {annotated && publication.tldr && (
    <div class="publication__annotation">
      <h4>TL;DR</h4>
      <p>{publication.tldr}</p>
    </div>
  )}
  {annotated && publication.highlight && (
    <div class="publication__annotation">
      <h4>Why It Matters</h4>
      <p>{publication.highlight}</p>
    </div>
  )}
</article>
