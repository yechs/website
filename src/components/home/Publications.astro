---
import PublicationLedgerEntry from './PublicationLedgerEntry.astro';
import { profile } from '../../data/profile';
import { publications } from '../../data/publications';

const orderedPublications = [...publications].sort((a, b) => b.year - a.year);
---

<section
  id="publications"
  class="home-publications home-shell"
  aria-labelledby="publications-heading"
>
  <header class="home-section-header">
    <h2 id="publications-heading" class="home-section-title">
      Publications
    </h2>
    <p class="home-publications__destinations">
      <a href="/publications/">Publications page</a>
      <a href={profile.scholar}>Google Scholar</a>
    </p>
  </header>
  <div class="home-publication-browser">
    <input
      id="include-all-publications"
      class="home-publication-toggle"
      type="checkbox"
      aria-controls="home-publication-records"
      aria-describedby="publication-view-status"
    />
    <p id="publication-view-status" class="home-publications__framing">
      <span class="home-publications__status--representative">
        Showing representative publications
      </span>
      <span class="home-publications__status--all">
        Showing all publications
      </span>
    </p>
    <label for="include-all-publications" class="home-publication-toggle-label">
      Include all publications
    </label>
    <div id="home-publication-records" class="home-publication-list">
      {orderedPublications.map((publication) => (
        <PublicationLedgerEntry
          publication={publication}
          compact={!publication.selected}
        />
      ))}
    </div>
  </div>
</section>
