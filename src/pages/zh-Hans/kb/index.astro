---
import { getCollection } from 'astro:content';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { kbSlug, kbTitle } from '../../../lib/content';

const entries = (await getCollection('knowledgeBaseZh')).sort((a, b) =>
  kbTitle(a).localeCompare(kbTitle(b), 'zh-CN'),
);
---

<BaseLayout title="技术笔记存档" description="Ye Shu 的个人技术笔记存档。">
  <div class="page-shell" lang="zh-Hans">
    <header class="page-heading">
      <p class="eyebrow">存档</p>
      <h1>技术笔记</h1>
      <p class="archive-disclaimer">
        这些是我多年积累的个人技术笔记。部分内容可能不完整或已经过时，目前不再持续维护。
      </p>
    </header>
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/zh-Hans/kb/${kbSlug(entry)}/`}>{kbTitle(entry)}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
