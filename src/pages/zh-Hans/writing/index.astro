---
import { getCollection } from 'astro:content';

import WritingList from '../../../components/WritingList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { writingDate } from '../../../lib/content';

const entries = (
  await getCollection('writingZh', ({ data }) => !data.draft)
).sort((a, b) => writingDate(b).valueOf() - writingDate(a).valueOf());
---

<BaseLayout title="中文文章" description="Ye Shu 的中文文章。">
  <div class="page-shell" lang="zh-Hans">
    <header class="page-heading">
      <p class="eyebrow">文章</p>
      <h1>中文文章</h1>
    </header>
    <WritingList entries={entries} />
  </div>
</BaseLayout>
