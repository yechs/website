---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import WritingLayout from '../../../layouts/WritingLayout.astro';
import { writingDate, writingSlug } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('writingZh', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: writingSlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writingZh'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<WritingLayout
  title={entry.data.title}
  description={`Ye Shu 的文章：${entry.data.title}。`}
  date={writingDate(entry)}
  lang="zh-Hans"
>
  <Content />
</WritingLayout>
