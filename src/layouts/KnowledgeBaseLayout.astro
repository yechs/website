---
import type { ArticleHeading } from '../lib/content';

import ArticleLayout from './ArticleLayout.astro';

interface Props {
  title: string;
  headings: ArticleHeading[];
  showTitle: boolean;
  hasMath?: boolean;
}

const { title, headings, showTitle, hasMath = false } = Astro.props;
// Keep the authored title (including its anchor) in the header without
// duplicating it. Content is trusted, repository-owned rendered Markdown.
const content = await Astro.slots.render('default');
const authoredTitle = !showTitle
  ? content.match(/<h1\b[^>]*>[\s\S]*?<\/h1>/)
  : null;
const body = authoredTitle ? content.replace(authoredTitle[0], '') : content;
---

<ArticleLayout
  title={title}
  description={`${title}, an archived technical note by Ye Shu.`}
  eyebrow={{ label: 'Technical Notes Archive', href: '/kb/' }}
  headings={headings}
  hasMath={hasMath}
>
  {authoredTitle && <Fragment slot="title" set:html={authoredTitle[0]} />}
  <Fragment set:html={body} />
</ArticleLayout>
