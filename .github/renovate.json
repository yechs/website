{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "labels": ["dependencies"],
  "reviewers": ["yechs"],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^@eslint\\//",
        "/^eslint(?:-|$)/",
        "/^typescript(?:-eslint)?$/",
        "globals",
        "husky",
        "lint-staged",
        "/^prettier(?:-|$)/"
      ],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "dev dependencies (non-major)",
      "groupSlug": "dev-dependencies"
    },
    {
      "matchPackageNames": [
        "/^@eslint\\//",
        "/^eslint(?:-|$)/",
        "/^typescript(?:-eslint)?$/",
        "globals",
        "husky",
        "lint-staged",
        "/^prettier(?:-|$)/"
      ],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "dev dependencies (major)",
      "groupSlug": "dev-dependencies-major"
    },
    {
      "matchPackageNames": ["astro", "@astrojs/**"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "Astro ecosystem",
      "groupSlug": "astro"
    },
    {
      "matchPackageNames": ["katex", "rehype-katex", "remark-math"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "Markdown math",
      "groupSlug": "markdown-math"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "matchPackageNames": ["katex"],
      "allowedVersions": "<0.17.0"
    }
  ]
}
