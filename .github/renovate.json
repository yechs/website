{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "labels": ["dependencies"],
  "reviewers": ["yechs"],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^@babel\\//",
        "/^@eslint\\//",
        "/^@tsconfig\\//",
        "/^@types\\//",
        "/^eslint(?:-|$)/",
        "/^typescript(?:-eslint)?$/",
        "globals",
        "husky",
        "lint-staged",
        "prettier"
      ],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "dev dependencies (non-major)",
      "groupSlug": "dev-dependencies"
    },
    {
      "matchPackageNames": [
        "/^@babel\\//",
        "/^@eslint\\//",
        "/^@tsconfig\\//",
        "/^@types\\//",
        "/^eslint(?:-|$)/",
        "/^typescript(?:-eslint)?$/",
        "globals",
        "husky",
        "lint-staged",
        "prettier"
      ],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "dev dependencies (major)",
      "groupSlug": "dev-dependencies-major"
    },
    {
      "matchPackageNames": ["@docusaurus/**"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "Docusaurus monorepo",
      "groupSlug": "docusaurus"
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "React monorepo",
      "groupSlug": "react"
    },
    {
      "matchPackageNames": [
        "react-masonry-css",
        "react-photo-album",
        "yet-another-react-lightbox"
      ],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "gallery dependencies",
      "groupSlug": "gallery-dependencies"
    },
    {
      "matchPackageNames": ["katex", "rehype-katex", "remark-math"],
      "schedule": ["before 3am on the first day of the month"],
      "groupName": "Docusaurus math",
      "groupSlug": "docusaurus-math"
    },
    {
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10.0.0"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "matchPackageNames": ["katex"],
      "allowedVersions": "<0.17.0"
    }
  ]
}
